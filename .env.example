# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SOLO servidor. Nunca exponer.

# ---------- Buzón (cPanel Hostinger) ----------
MAIL_ADDRESS=examenes@centicsas.com.co
MAIL_FROM_NAME="Exámenes CENTIC"
# MAIL_USER=examenes@centicsas.com.co   # por defecto = MAIL_ADDRESS
MAIL_PASSWORD=

IMAP_HOST=mail.centicsas.com.co     # ver cPanel → Cuentas de correo → Connect Devices
IMAP_PORT=993
# IMAP_INBOX=INBOX
# IMAP_SENT_MAILBOX=INBOX.Sent      # se detecta solo; definir si falla
INITIAL_SYNC_DAYS=0                 # 0 = traer TODO el histórico en la primera sincronización
HISTORIC_DAYS=3                     # correos más viejos que esto = históricos (van a triage, no disparan IA por mensaje)
BACKFILL_ATTACHMENTS=false          # true = guardar también archivos adjuntos históricos en Storage

# ---------- Gmail (cuenta con la que se ha gestionado el buzón) ----------
# Requiere verificación en 2 pasos + contraseña de aplicación: https://myaccount.google.com/apppasswords
# y IMAP activado en Gmail → Configuración → Reenvío y correo POP/IMAP.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# GMAIL_MAILBOX="[Gmail]/Todos"     # se detecta solo (carpeta \All)
# GMAIL_FILTER=                     # por defecto: from/to/cc/deliveredto examenes@... ; dejar "" vacío si la cuenta es exclusiva del buzón
# OWN_ADDRESSES=otra@centicsas.com.co   # otras direcciones desde las que el equipo responde
TRIAGE_CONCURRENCY=4

SMTP_HOST=mail.centicsas.com.co
SMTP_PORT=465

# ---------- Seguridad ----------
CRON_SECRET=                        # openssl rand -hex 32
MCP_TOKEN=                          # openssl rand -hex 32

# ---------- IA ----------
# Por defecto NO hay IA dentro de la app: Claude Code hace la clasificación, el triage
# y las propuestas de respuesta conectándose por MCP (ver README).
AI_PROVIDER=none                    # none | deepseek | anthropic
# DeepSeek (opcional, futuro): con esto el cron clasifica y hace triage solo
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL_HIGH=deepseek-chat # modelo para redactar respuestas
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Anthropic (opcional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

APP_URL=https://tu-app.vercel.app
